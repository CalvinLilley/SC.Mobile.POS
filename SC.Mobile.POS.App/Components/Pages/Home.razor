@page "/"

<div class="pos-shell">
    @if (CurrentScreen == PosScreen.Order)
    {
        <section class="order-screen">
            <header class="menu-bar">
                <button class="menu-button" aria-label="Open menu">☰</button>
                <span class="menu-title">POS</span>
                <span class="cart-indicator" title="Items in cart">(@CartCount)</span>
            </header>

            <div class="customer-strip">
                <div>
                    <div class="customer-name">@SelectedCustomer.Name</div>
                    <div class="customer-code">@SelectedCustomer.Code</div>
                </div>
                <button class="switch-button" @onclick="OpenCustomerSelection">Switch</button>
            </div>

            <button class="payment-button" @onclick="OpenPaymentScreen">
                <span>Take Payment</span>
                <strong>@OrderTotal.ToString("C")</strong>
            </button>

            <div class="entry-row">
                <input @bind="SearchTerm" placeholder="Scan or enter stock code" />
                <input class="qty-input" type="number" min="1" @bind="QuantityText" />
                <button @onclick="SearchProducts">Search</button>
            </div>

            <section class="results-list">
                @foreach (var product in SearchResults)
                {
                    <article class="result-card">
                        <div>
                            <h3>@product.StockCode</h3>
                            <p>@product.Description</p>
                        </div>
                        <div class="result-actions">
                            <span>@product.Price.ToString("C")</span>
                            <button @onclick="() => AddProduct(product)">+</button>
                        </div>
                    </article>
                }
            </section>
        </section>
    }
    else if (CurrentScreen == PosScreen.CustomerSelection)
    {
        <section class="sub-screen">
            <h2>Select Customer</h2>
            <div class="list-stack">
                @foreach (var customer in Customers)
                {
                    <button class="list-item" @onclick="() => SelectCustomer(customer)">
                        <strong>@customer.Name</strong>
                        <span>@customer.Code</span>
                    </button>
                }
            </div>
            <button class="secondary" @onclick="BackToOrder">Back</button>
        </section>
    }
    else
    {
        <section class="sub-screen">
            <h2>Take Payment</h2>
            <div class="totals">
                <div><span>Items</span><strong>@CartCount</strong></div>
                <div><span>Total</span><strong>@OrderTotal.ToString("C")</strong></div>
            </div>
            <div class="list-stack">
                @foreach (var method in PaymentMethods)
                {
                    <button class="list-item" @onclick="BackToOrder">@method</button>
                }
            </div>
            <button class="secondary" @onclick="BackToOrder">Cancel</button>
        </section>
    }
</div>

@code {
    private PosScreen CurrentScreen { get; set; } = PosScreen.Order;
    private Customer SelectedCustomer { get; set; } = new("CASH Customer walk in", "CASH");
    private string SearchTerm { get; set; } = string.Empty;
    private string QuantityText { get; set; } = "1";
    private int CartCount { get; set; } = 3;

    private decimal OrderTotal => Cart.Sum(x => x.Price * x.Quantity);

    private List<CartItem> Cart { get; } =
    [
        new("Stock Code", "Description", 50.50m, 1),
        new("Stock Code", "Description", 50.50m, 1),
        new("Stock Code", "Description", 50.50m, 2)
    ];

    private List<Product> SearchResults { get; set; } =
    [
        new("Stock Code", "Description", 50.50m),
        new("Stock Code", "Description", 50.50m),
        new("Stock Code", "Description", 50.50m),
        new("Stock Code", "Description", 50.50m)
    ];

    private List<Customer> Customers { get; } =
    [
        new("CASH Customer walk in", "CASH"),
        new("Acme Retail", "ACM001"),
        new("Bluebird Traders", "BLU334")
    ];

    private static readonly string[] PaymentMethods = ["Cash", "Card", "Mobile Wallet", "On Account"];

    private void SearchProducts()
    {
        var seeded = new List<Product>
        {
            new("Stock Code", "Description", 50.50m),
            new("12345", "Popular barcode match", 25.00m),
            new("88990", "Searched item", 75.99m)
        };

        SearchResults = string.IsNullOrWhiteSpace(SearchTerm)
            ? seeded
            : seeded.Where(x =>
                x.StockCode.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                x.Description.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void AddProduct(Product product)
    {
        var quantity = int.TryParse(QuantityText, out var parsed) && parsed > 0 ? parsed : 1;

        Cart.Add(new CartItem(product.StockCode, product.Description, product.Price, quantity));
        CartCount = Cart.Sum(x => x.Quantity);
    }

    private void OpenCustomerSelection() => CurrentScreen = PosScreen.CustomerSelection;

    private void OpenPaymentScreen() => CurrentScreen = PosScreen.Payment;

    private void BackToOrder() => CurrentScreen = PosScreen.Order;

    private void SelectCustomer(Customer customer)
    {
        SelectedCustomer = customer;
        CurrentScreen = PosScreen.Order;
    }

    private enum PosScreen
    {
        Order,
        CustomerSelection,
        Payment
    }

    private sealed record Product(string StockCode, string Description, decimal Price);
    private sealed record Customer(string Name, string Code);
    private sealed record CartItem(string StockCode, string Description, decimal Price, int Quantity);
}
